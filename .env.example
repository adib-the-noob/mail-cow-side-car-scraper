# Where the sidecar listens. Keep it on localhost unless you front it with a
# reverse proxy / firewall. The API exposes DKIM private keys, so treat it as
# sensitive.
SIDECAR_HOST=127.0.0.1
SIDECAR_PORT=8800

# Optional bearer token. If set, every /api/v1/* request must send
#   Authorization: Bearer <token>
# Leave empty to disable auth (only safe when bound to localhost).
SIDECAR_API_TOKEN=

# Mailcow install directory (must contain mailcow.conf). Auto-detected from
# /opt/mailcow-dockerized, /opt/mailcow, /srv/mailcow-dockerized when unset.
# You may also set MAILCOW_DIR instead.
SIDECAR_MAILCOW_DIR=/opt/mailcow-dockerized

# Docker Compose project name. Defaults to COMPOSE_PROJECT_NAME from
# mailcow.conf (mailcowdockerized).
# SIDECAR_COMPOSE_PROJECT=mailcowdockerized

# Docker CLI used to exec into mailcow containers.
SIDECAR_DOCKER_BIN=docker

# Timeout (seconds) for a single `docker exec` call.
SIDECAR_REQUEST_TIMEOUT=30

# How long (seconds) scraped data is cached before hitting the containers again.
SIDECAR_CACHE_TTL=30

# --- Reconciler (optional) -------------------------------------------------
# Push this node's configuration into ANOTHER mailcow node via its REST API.
# The target needs an API key with access='rw' whose allow_from covers this
# host's source IP. Leave blank to keep the sidecar strictly read-only.
SIDECAR_TARGET_URL=
SIDECAR_TARGET_API_KEY=
# Set to false for self-signed certs on the target.
SIDECAR_TARGET_VERIFY_TLS=true
SIDECAR_TARGET_TIMEOUT=30

# --- Replication peer defaults (optional) ----------------------------------
# Used when a /replicate/push or /replicate/peer request omits these fields.
# The peer is *another sidecar*, so peer_token is that node's SIDECAR_API_TOKEN.
SIDECAR_PEER_TOKEN=
SIDECAR_PEER_VERIFY_TLS=true
SIDECAR_PEER_TIMEOUT=120
